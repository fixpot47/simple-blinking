{
  "schemaVersion": 1,
  "id": "simple_blinking",
  "version": "${version}",
  "name": "Simple Blinking",
  "description": "Smooth, natural blinking for your Minecraft skin.",
  "authors": ["fixpot47"],
  "contact": {
    "sources": "https://github.com/fixpot47/simple-blinking"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
